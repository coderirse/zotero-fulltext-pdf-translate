{
  "name": "zotero-fulltext-pdf-translate",
  "type": "module",
  "version": "0.2.0",
  "description": "Translate whole PDFs into layout-preserving bilingual PDFs inside Zotero, with your own LLM API keys. Powered by pdf2zh (BabelDOC).",
  "config": {
    "addonName": "Full PDF Translate",
    "addonID": "fullpdf-translate@shang.dev",
    "addonRef": "fullpdf",
    "addonInstance": "FullPDFTranslate",
    "prefsPrefix": "extensions.zotero.fullpdf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderirse/zotero-fulltext-pdf-translate.git"
  },
  "author": "coderirse",
  "bugs": {
    "url": "https://github.com/coderirse/zotero-fulltext-pdf-translate/issues"
  },
  "homepage": "https://github.com/coderirse/zotero-fulltext-pdf-translate#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
